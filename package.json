{
  "name": "obsidian-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Obsidian vault integration with Claude Desktop",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "obsidian-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "install-global": "npm run build && npm install -g .",
    "setup": "node scripts/setup.js",
    "setup-claude-desktop": "node scripts/setup-claude-desktop.js",
    "build-extension": "node scripts/build-extension.js",
    "test": "node scripts/test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "claude-desktop",
    "model-context-protocol",
    "ai",
    "knowledge-management"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raoof128/obsidian-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Raoof128/obsidian-mcp-server/issues"
  },
  "homepage": "https://github.com/Raoof128/obsidian-mcp-server#readme"
}